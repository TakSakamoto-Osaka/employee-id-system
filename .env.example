# backend/.env.example
# Copy to backend/.env for local (non-Docker) development. Never commit
# real secrets (spec 9.4: パスワードや秘密鍵をソースコードへ埋め込まない).
#
# Settings (app/config.py) are read from real process environment variables
# first and this .env file second, so the same code switches between dev and
# production automatically depending on where the values come from:
#   - Local dev: this .env file.
#   - Vercel production: Project Settings -> Environment Variables (see
#     .env.production.example for what to set there — never commit real
#     production secrets to a file).

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/employee_id
# For quick local testing without PostgreSQL:
# DATABASE_URL=sqlite:///./dev.db

AUTH_SECRET_KEY=dev-only-secret-change-me
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

IMPORT_STORAGE_DIR=./data/imports
